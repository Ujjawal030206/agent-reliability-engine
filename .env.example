# Copy this file to .env and fill in ONE provider block below.
#
# The engine talks to whichever provider LLM_PROVIDER names. Everything in
# src/ is provider-agnostic - llm_providers.py adapts a free OpenAI-compatible
# API to the client surface the harness expects.
#
# The target agent under test is a TOOL-USING agent, so whichever model you
# pick must support function/tool calling. The defaults below all do.

# ---------------------------------------------------------------------------
# Option 1 - Groq (free tier, recommended)
# Get a key at https://console.groq.com/keys - no card required.
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your-key-here
AGENT_MODEL=openai/gpt-oss-120b
JUDGE_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Option 2 - Google Gemini (free tier)
# Get a key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-key-here
# AGENT_MODEL=gemini-2.0-flash
# JUDGE_MODEL=gemini-2.0-flash-lite

# ---------------------------------------------------------------------------
# Option 3 - OpenRouter (free models, ":free" suffix)
# Get a key at https://openrouter.ai/keys
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-your-key-here
# AGENT_MODEL=meta-llama/llama-3.3-70b-instruct:free
# JUDGE_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---------------------------------------------------------------------------
# Option 4 - Ollama, fully local: no key, no network, no rate limits.
# Install from https://ollama.com, then: ollama pull llama3.1
# ---------------------------------------------------------------------------
# LLM_PROVIDER=ollama
# AGENT_MODEL=llama3.1
# JUDGE_MODEL=llama3.1

# ---------------------------------------------------------------------------
# Option 5 - any other OpenAI-compatible endpoint
# ---------------------------------------------------------------------------
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_API_KEY=your-key-here
# AGENT_MODEL=your-model
# JUDGE_MODEL=your-model

# ---------------------------------------------------------------------------
# Option 6 - Anthropic (paid; the original configuration)
# ---------------------------------------------------------------------------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# AGENT_MODEL=claude-sonnet-5
# JUDGE_MODEL=claude-haiku-4-5-20251001
