# Copy this file to .env and fill in your key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used by the TARGET AGENT (Riley) being evaluated.
AGENT_MODEL=claude-sonnet-5

# Model used by the FAILURE CLASSIFIER's LLM-as-judge layer.
# Haiku is fast/cheap and works well as a judge for this scale of transcript.
JUDGE_MODEL=claude-haiku-4-5-20251001
